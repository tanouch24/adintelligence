generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  META
  TIKTOK
  GOOGLE
  YOUTUBE
  LINKEDIN
  OTHER
}

enum CreativeType {
  IMAGE
  VIDEO
  CAROUSEL
  OTHER
}

enum WatchlistType {
  KEYWORD
  ADVERTISER
}

enum GeneratedCreativeStatus {
  DRAFT
  GENERATING
  READY
  ARCHIVED
}

model Project {
  id           String                   @id @default(cuid())
  slug         String                   @unique
  name         String
  description  String?
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  projectAds   ProjectAd[]
  watchlists   Watchlist[]
  swipeItems   SwipeFileItem[]
  generated    GeneratedCreative[]
  ownAccounts  OwnAdAccount[]
  campaigns    OwnCampaign[]
  performances OwnCampaignPerformance[]
}

model Advertiser {
  id         String   @id @default(cuid())
  platform   Platform
  externalId String?
  name       String
  handle     String?
  website    String?
  country    String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ads        Ad[]

  @@unique([platform, externalId])
  @@index([platform, name])
}

model Ad {
  id                String              @id @default(cuid())
  platform          Platform
  externalId        String
  advertiserId      String
  primaryText       String?
  headline          String?
  description       String?
  callToAction      String?
  landingPageUrl    String?
  sourceUrl         String?
  firstSeenAt       DateTime            @default(now())
  lastSeenAt        DateTime            @default(now())
  platformStartedAt DateTime?
  platformEndedAt   DateTime?
  active            Boolean             @default(true)
  country           String?
  language          String?
  rawPayload        Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  advertiser        Advertiser          @relation(fields: [advertiserId], references: [id], onDelete: Restrict)
  creatives         Creative[]
  projectAds        ProjectAd[]
  observations      AdObservation[]
  swipeItems        SwipeFileItem[]
  analyses          Analysis[]
  signalScores      SignalScore[]
  publicMetrics     PublicMetrics[]
  generatedFrom     GeneratedCreative[]
  ownAdLinks        OwnAd[]

  @@unique([platform, externalId])
  @@index([advertiserId])
  @@index([firstSeenAt])
  @@index([lastSeenAt])
  @@index([active])
}

model Creative {
  id              String       @id @default(cuid())
  adId            String
  externalId      String?
  type            CreativeType
  sourceUrl       String?
  thumbnailUrl    String?
  width           Int?
  height          Int?
  durationSeconds Int?
  mimeType        String?
  checksum        String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  ad              Ad           @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, externalId])
  @@index([adId])
}

model ProjectAd {
  projectId       String
  adId            String
  relevanceScore  Float?
  matchedKeywords String[]
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ad              Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@id([projectId, adId])
  @@index([adId])
  @@index([projectId, createdAt])
}

model Watchlist {
  id            String        @id @default(cuid())
  projectId     String
  type          WatchlistType
  query         String
  platform      Platform?
  country       String?
  active        Boolean       @default(true)
  lastCheckedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, active])
  @@index([type, platform])
}

model SwipeFileItem {
  id        String   @id @default(cuid())
  projectId String
  adId      String
  notes     String?
  tags      String[]
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([projectId, adId])
  @@index([projectId, createdAt])
}

model Analysis {
  id                   String   @id @default(cuid())
  adId                 String
  hook                 String?
  angle                String?
  problem              String?
  promise              String?
  offer                String?
  proof                String?
  callToActionAnalysis String?
  targetAudience       String?
  visualStyle          String?
  tags                 String[]
  notes                String?
  model                String?
  version              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ad                   Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, version])
  @@index([adId, createdAt])
}

model SignalScore {
  id                      String   @id @default(cuid())
  adId                    String
  score                   Int
  longevitySignal         Int
  reachSignal             Int?
  recurrenceSignal        Int
  creativeVariationSignal Int
  freshnessSignal         Int
  confidence              Float
  explanation             String
  algorithmVersion        String
  calculatedAt            DateTime @default(now())
  ad                      Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, calculatedAt])
  @@index([score])
}

model PublicMetrics {
  id               String   @id @default(cuid())
  adId             String
  impressionsLower Int?
  impressionsUpper Int?
  reachLower       Int?
  reachUpper       Int?
  spendLower       Decimal? @db.Decimal(12, 2)
  spendUpper       Decimal? @db.Decimal(12, 2)
  currency         String?
  metadata         Json?
  capturedAt       DateTime @default(now())
  ad               Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, capturedAt])
}

model AdObservation {
  id            String   @id @default(cuid())
  adId          String
  observedAt    DateTime @default(now())
  active        Boolean
  publicMetrics Json?
  metadata      Json?
  ad            Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, observedAt])
  @@index([adId, active])
  @@index([observedAt])
}

model GeneratedCreative {
  id         String                  @id @default(cuid())
  projectId  String
  sourceAdId String?
  type       CreativeType
  concept    String
  prompt     String
  format     String
  width      Int?
  height     Int?
  assetUrl   String?
  status     GeneratedCreativeStatus @default(DRAFT)
  model      String?
  version    Int                     @default(1)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  project    Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAd   Ad?                     @relation(fields: [sourceAdId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([sourceAdId])
}

model OwnAdAccount {
  id         String        @id @default(cuid())
  projectId  String
  platform   Platform
  externalId String
  name       String
  currency   String?
  metadata   Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaigns  OwnCampaign[]

  @@unique([platform, externalId])
  @@index([projectId, platform])
}

model OwnCampaign {
  id           String                   @id @default(cuid())
  accountId    String
  projectId    String
  externalId   String
  name         String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  account      OwnAdAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  adSets       OwnAdSet[]
  performances OwnCampaignPerformance[]

  @@unique([accountId, externalId])
  @@index([projectId, name])
}

model OwnAdSet {
  id         String      @id @default(cuid())
  campaignId String
  externalId String
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  campaign   OwnCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads        OwnAd[]

  @@unique([campaignId, externalId])
}

model OwnAd {
  id         String   @id @default(cuid())
  adSetId    String
  sourceAdId String?
  externalId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  adSet      OwnAdSet @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  sourceAd   Ad?      @relation(fields: [sourceAdId], references: [id], onDelete: SetNull)

  @@unique([adSetId, externalId])
  @@index([sourceAdId])
}

model OwnCampaignPerformance {
  id          String      @id @default(cuid())
  projectId   String
  campaignId  String
  date        DateTime
  spend       Decimal?    @db.Decimal(12, 2)
  impressions Int?
  reach       Int?
  clicks      Int?
  ctr         Float?
  cpc         Decimal?    @db.Decimal(12, 4)
  cpm         Decimal?    @db.Decimal(12, 4)
  leads       Int?
  cpl         Decimal?    @db.Decimal(12, 4)
  conversions Int?
  cpa         Decimal?    @db.Decimal(12, 4)
  revenue     Decimal?    @db.Decimal(12, 2)
  roas        Float?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaign    OwnCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([projectId, date])
}
